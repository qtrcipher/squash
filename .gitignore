# OS junk
.DS_Store
Thumbs.db

# Secrets / env — never commit
.env
.env.*
*.pem
*.key
secrets/

# Build outputs (common across stacks)
build/
dist/
out/
target/
node_modules/
__pycache__/
*.o
*.obj
*.exe

# Logs
*.log

# Fuzzing (cargo-fuzz): corpora are regenerable via fuzz/seed-corpus.sh,
# artifacts are crash findings (kept locally until triaged), target/ is the
# nightly sanitizer build.
fuzz/corpus/
fuzz/artifacts/
fuzz/smoke-logs/
fuzz/target/

# Benchmark artifacts: generated corpus + local result tracking stay out of
# git (benches/baseline.json and benches/corpus/README.md are committed).
benches/corpus/*
!benches/corpus/README.md
benches/results.jsonl

# Frontend / Tauri
app/dist/
app/dist-snapshots/
app/snapshots-tmp/
app/src-tauri/target/
app/src-tauri/gen/
*.tsbuildinfo
.vite/
