# libFuzzer dictionary: archive magic bytes + structural markers.
# Passed via `-dict=fuzz/dictionaries/archive.dict`.

# zip
"PK\x03\x04"
"PK\x01\x02"
"PK\x05\x06"
"PK\x07\x08"
# rar (RAR4 + RAR5 signatures)
"Rar!\x1a\x07\x00"
"Rar!\x1a\x07\x01\x00"
# 7z
"7z\xbc\xaf\x27\x1c"
# gzip
"\x1f\x8b\x08"
# zstd
"\x28\xb5\x2f\xfd"
# bzip2
"BZh9"
# xz
"\xfd7zXZ\x00"
# tar ustar marker (at offset 257)
"ustar"
"ustar\x0000"
